// Prisma schema for the saree storefront
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Address {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  label       String   @default("Home") // e.g. Home, Work, Other — free text
  fullName    String
  phone       String
  addressLine String
  city        String
  state       String
  pincode     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique // stored uppercase, matched case-insensitively
  type          String // "PERCENTAGE" or "FIXED"
  value         Decimal  @db.Decimal(10, 2) // percentage points (e.g. 10) or flat INR amount
  minOrderValue Decimal  @default(0) @db.Decimal(10, 2)
  maxDiscount   Decimal? @db.Decimal(10, 2) // caps a PERCENTAGE discount; ignored for FIXED
  usageLimit    Int? // null = unlimited
  usedCount     Int      @default(0)
  active        Boolean  @default(true)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
}

model WholesaleInquiry {
  id           String   @id @default(uuid())
  name         String
  businessName String?
  email        String
  phone        String
  message      String
  createdAt    DateTime @default(now())
}

// Singleton row (id is always "singleton") holding store-wide settings that
// the admin can change without a code deploy — currently just the color
// theme, but a natural place to add more later (e.g. store name, shipping
// fee) without new migrations for each one.
model StoreSetting {
  id        String   @id @default("singleton")
  theme     String   @default("royal") // "royal" | "purple" | "pink"
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

// A saree design can come in multiple colors, each with its own stock —
// e.g. "Cotton Saree" in Blue (12 left) and Green (5 left). Variants are
// OPTIONAL: a product with no variants behaves exactly as before (its own
// `color`/`stock` fields are the single source of truth). A product WITH
// variants uses variant.stock for availability/checkout instead — the
// storefront shows a color swatch picker once any variants exist.
model ProductVariant {
  id         String      @id @default(uuid())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  color      String
  colorHex   String? // e.g. "#1B3A6B" — used to render a swatch dot; falls back to a text label if omitted
  stock      Int         @default(0)
  images     String[]    @default([]) // optional — photos specific to THIS color. Falls back to the product's own images when empty.
  sku        String?     @unique
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())

  @@unique([productId, color])
  @@index([productId])
}

model Product {
  id             String      @id @default(uuid())
  name           String
  slug           String      @unique
  description    String
  fabric         String // e.g. Kalanjali Paithani, Maheshwari Cotton, Chiffon, Georgette
  color          String
  occasion       String // e.g. Wedding, Festive, Casual, Party
  price          Decimal     @db.Decimal(10, 2) // MRP in INR
  discountPrice  Decimal?    @db.Decimal(10, 2) // Selling price in INR
  stock          Int         @default(0)
  images         String[] // array of image URLs
  featured       Boolean     @default(false)
  rating         Decimal     @default(0) @db.Decimal(2, 1) // average of Review.rating, kept in sync on write
  reviewCount    Int         @default(0)
  category       Category    @relation(fields: [categoryId], references: [id])
  categoryId     String
  variants       ProductVariant[]
  orderItems     OrderItem[]
  reviews        Review[]
  wishlistedBy   WishlistItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([categoryId])
  @@index([featured])
}

model Review {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int // 1-5
  comment   String
  verified  Boolean  @default(false) // true if the reviewer has a paid order containing this product
  createdAt DateTime @default(now())

  @@unique([productId, userId]) // one review per customer per product
  @@index([productId])
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique // human friendly, e.g. SS-20260813-0001
  user              User?       @relation(fields: [userId], references: [id])
  userId            String? // null for guest checkout
  customerName      String
  email             String
  phone             String
  addressLine       String
  city               String
  state             String
  pincode           String
  subtotal          Decimal     @db.Decimal(10, 2)
  shippingFee       Decimal     @default(0) @db.Decimal(10, 2)
  couponCode        String?
  discountAmount    Decimal     @default(0) @db.Decimal(10, 2)
  giftWrap          Boolean     @default(false)
  giftWrapFee       Decimal     @default(0) @db.Decimal(10, 2)
  giftNote          String?
  totalAmount       Decimal     @db.Decimal(10, 2)
  status            OrderStatus @default(PENDING)
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  razorpaySignature String?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([email])
  @@index([userId])
  @@index([razorpayOrderId])
}

model OrderItem {
  id           String          @id @default(uuid())
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  product      Product         @relation(fields: [productId], references: [id])
  productId    String
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId    String? // null for products without variants
  variantColor String? // snapshot — survives even if the variant is later deleted/renamed
  productName  String // snapshot at time of order
  price        Decimal         @db.Decimal(10, 2) // snapshot price at time of order
  quantity     Int

  @@index([orderId])
  @@index([variantId])
}
