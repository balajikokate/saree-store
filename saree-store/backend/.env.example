# PostgreSQL connection string (Neon / Render / Railway / Supabase all work)
DATABASE_URL="postgresql://user:password@host:5432/saree_store?sslmode=require"

# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (your deployed frontend URL).
# IMPORTANT: the admin panel's login session is a cross-site cookie, which
# requires an EXACT origin match here — no wildcards, no trailing slash.
# e.g. "https://saree-store.vercel.app" not "https://saree-store.vercel.app/"
CLIENT_URL="http://localhost:5173"

# Razorpay (get these from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxx"
# Set up in Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# (URL: https://your-backend-url/api/webhooks/razorpay, events: payment.captured, payment.failed)
# This is a DIFFERENT secret from RAZORPAY_KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET="paste-the-webhook-secret-here"

# Admin panel login (single admin account — no separate signup flow)
ADMIN_EMAIL="admin@oveecollection.example"
# Generate this with: node scripts/hash-password.js "your-chosen-password"
ADMIN_PASSWORD_HASH="paste-the-generated-hash-here"
# Any long random string — used to sign admin session tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"

# Optional but recommended: lets you clear an admin login lockout (5 failed
# attempts locks you out for 15 min) without waiting or redeploying.
# Generate one the same way as JWT_SECRET, then use it via the "Locked out?"
# link on the admin login page, or POST /api/admin/unlock-lockout.
# Leave unset to disable this feature entirely.
ADMIN_UNLOCK_SECRET="change-this-to-a-different-long-random-string"

# --- Order notifications (all optional — each channel is skipped if unset) ---

# Email via Resend (https://resend.com) — free tier covers a few thousand/month
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="orders@yourdomain.com"

# Where admin notifications go (defaults to ADMIN_EMAIL if unset)
ADMIN_NOTIFY_EMAIL=""
# Admin's phone for SMS/WhatsApp alerts, plain 10-digit Indian number
ADMIN_NOTIFY_PHONE=""

# SMS + WhatsApp via Twilio (https://twilio.com) — one account, both channels.
# See README.md "Order Notifications" section for setup + trial-account limits.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_SMS_FROM="+1xxxxxxxxxx"
TWILIO_WHATSAPP_FROM="+14155238886"
